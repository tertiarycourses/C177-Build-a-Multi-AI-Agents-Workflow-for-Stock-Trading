# Copy to .env and fill in. Never commit .env.
OFFLINE=true                      # true = sample data + simulated paper broker, no keys needed

# LLM brain for the agents: anthropic | openai | none (none = rule-based brains)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Finance Research Agent
TWELVEDATA_API_KEY=               # https://twelvedata.com/account/api-keys  (1min / 15min / 1h candles)
EQUIBLES_API_KEY=                 # https://equibles.com/dashboard/apikeys     (valuation, short interest, insiders)
# Yahoo Finance company data comes from the yfinance package (no key)

# News Sentiment Agent
NEWSAPI_KEY=                      # https://newsapi.org/account
REDDIT_CLIENT_ID=                 # https://www.reddit.com/prefs/apps  -> create a "script" app
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-agents/1.0 by your-reddit-username
REDDIT_SUBREDDITS=stocks,wallstreetbets,investing

# Stock Trader Agent - Alpaca PAPER account only
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
POSITION_PCT=0.10                 # fraction of equity per trade
